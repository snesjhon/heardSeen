# --- Supabase ---
# From your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the client. Used by seed scripts and admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apple Music Catalog API (album metadata) ---
# From your Apple Developer account > Certificates, Identifiers & Profiles > Keys.
# Requires an active Apple Developer Program membership (~$99/yr) to create a MusicKit key.
# This signs a developer-token JWT server-side (seed script only, never shipped to the
# browser) and calls the Catalog REST API directly — no MusicKit JS, no end-user Apple
# Music subscription, no authorize() consent flow needed for metadata/artwork lookup.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to your downloaded .p8 private key file (relative to the project root, or
# absolute). This only needs to exist locally, wherever you run `pnpm run seed:generate`
# -- never commit the actual .p8 file (see .gitignore). e.g.:
# APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY_PATH=

# --- TMDB (movie metadata) ---
# Free API key from https://www.themoviedb.org/settings/api
# Apple has no public catalog/search API for movies or TV at any price — the iTunes
# Search API's movie index is empty as of 2026 (that catalog now lives under the Apple TV
# app), and MusicKit only covers music. TMDB is the reliable alternative for movie
# metadata; the Apple TV deep link is a best-effort tv.apple.com search link as a result
# (see src/lib/tmdb/movies.ts for why there's no exact per-title mapping).
TMDB_API_KEY=
