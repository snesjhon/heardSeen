# --- Supabase ---
# From your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the client. Used by seed scripts and admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (movie metadata) ---
# Free API key from https://www.themoviedb.org/settings/api
# The iTunes Search API's movie index is empty as of 2026 (Apple's catalog now lives
# under the Apple TV app, which has no public developer API), so movies are sourced
# from TMDB instead. Album metadata still comes from the free, keyless iTunes Search API.
TMDB_API_KEY=

# Albums (iTunes Search API, entity=album) need no key/auth.
